{
  "name": "@omnidotdev/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless collaborative rich-text editor (Lexical + Yjs + Hocuspocus) shared across Omni products",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "bun src/scripts/build.ts",
    "check": "biome check --diagnostic-level=error src",
    "clean": "rm -rf build node_modules",
    "dev": "bun build src/index.ts --outdir build --target browser --watch",
    "format": "biome format --write src",
    "knip": "knip-bun --cache --tags=-knipignore",
    "lint": "biome lint --write src",
    "release": "bun run build && changeset publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "omni",
    "editor",
    "lexical",
    "yjs",
    "hocuspocus",
    "collaborative",
    "rich-text"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/omnidotdev/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnidotdev/editor.git"
  },
  "bugs": "https://github.com/omnidotdev/editor/issues",
  "author": "Omni <hey@omni.dev>",
  "packageManager": "bun@1.3.6",
  "peerDependencies": {
    "@hocuspocus/provider": "^3.4.4",
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@lexical/yjs": "^0.39.0",
    "lexical": "^0.39.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "yjs": "^13.6.29"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "y-indexeddb": "^9.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@hocuspocus/provider": "^3.4.4",
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@lexical/yjs": "^0.39.0",
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lexical": "^0.39.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "yjs": "^13.6.29"
  }
}
